# CoreDNS configuration — policy enforcement mode
#
# The sandboxpolicy plugin enforces DNS-level access control:
#   - Only domains listed in the policy file are resolved
#   - All other domains receive NXDOMAIN
#   - AAAA records are stripped (IPv4-only networking)
#   - ECH SvcParams are stripped from SVCB/HTTPS records (prevents TLS
#     ECH bypass); records themselves and their non-ECH SvcParams reach
#     the VM unchanged
#   - Resolved domain→IP mappings are reported to a JSON file
#   - Every allow/deny decision is also written as a JSONL line to
#     `events_file`; sandboxd tails the file and ingests the stream into the
#     unified event bus. The file lives in the per-session events bind mount
#     created by sandboxd so it survives the gateway tmpfs.
#
# The policy file is generated by sandboxd and reloaded automatically.

. {
    sandboxpolicy {
        policy_file /etc/coredns/policy.conf
        report_file /etc/coredns/resolved.json
        events_file /var/log/gateway/events/coredns.jsonl
        # Synchronous DNS-policy gate. The plugin blocks each A-record
        # response on a per-session UDS until sandboxd has injected the
        # resolved IPs into nft and Envoy has acked the matching listener
        # generation. Fail-open on deadline (default 1500ms) so a stuck
        # daemon never punches a hole in DNS resolution.
        gate_socket /var/log/gateway/events/dns-gate.sock
        reload 1s
    }
    # Upstream forwarder. The default is Docker's container-local embedded
    # DNS at 127.0.0.11: on Linux the gateway container runs on the host's
    # Docker, where 127.0.0.11 sidesteps the public-resolver reachability
    # flakiness seen forwarding through the host `docker0` → SLIRP/QEMU path
    # (transient SERVFAIL for an allowed domain); it lives in the same netns,
    # has zero hops, and proxies to the host's real upstream via dockerd's
    # own resolver code.
    #
    # This line is rendered by entrypoint.sh from SANDBOX_COREDNS_UPSTREAM
    # (default `127.0.0.11`, so the Linux behaviour is byte-for-byte
    # unchanged). On macOS the gateway container runs *inside* the gateway
    # Lima VM, where Docker's embedded 127.0.0.11 forwarder is a dead end —
    # its own upstream (the VM's 127.0.0.53 systemd-resolved stub) does not
    # answer — so an allowed domain SERVFAILs even though the policy admits
    # it. There the macOS create path sets SANDBOX_COREDNS_UPSTREAM to public
    # resolvers, which the VM reaches directly over eth0 (port 53 is allowed
    # by the gateway-VM egress firewall). Deny is unaffected either way: a
    # denied domain is answered NXDOMAIN before this forward runs.
    forward . 127.0.0.11
    log
    health :8180
    ready :8181
}
